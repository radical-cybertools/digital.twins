diff --git a/tasks/common/r8_timing.py b/tasks/common/r8_timing.py
new file mode 100644
index 0000000..8eb172f
--- /dev/null
+++ b/tasks/common/r8_timing.py
@@ -0,0 +1,33 @@
+"""Round 8 (DT paper, R8-E) instrumentation, a local patch, never pushed.
+
+Task bodies record wall times here; `LAST` holds the most recent eval's
+phase times (setup, tar extraction, model reload, field, cleanup), which
+the investigators return with each answer.  `log()` appends one JSON line
+per event to $R8_TIMING_DIR/<name>-<pid>.jsonl (one file per process, so
+concurrent workers never interleave).  `CACHE` keeps loaded models per
+worker process, keyed by archive path, when R8_WARM_MODEL=1 (the
+warm-model variant).
+"""
+import json
+import os
+import time
+
+LAST: dict = {}
+CACHE: dict = {}
+
+
+def warm() -> bool:
+    return os.environ.get("R8_WARM_MODEL") == "1"
+
+
+def log(name: str, **rec) -> None:
+    d = os.environ.get("R8_TIMING_DIR")
+    if not d:
+        return
+    rec.setdefault("pid", os.getpid())
+    rec.setdefault("logged", time.time())
+    try:
+        with open(os.path.join(d, f"{name}-{os.getpid()}.jsonl"), "a") as f:
+            f.write(json.dumps(rec, default=str) + "\n")
+    except OSError:
+        pass
